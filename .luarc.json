{
    "runtime.version": "LuaJIT",
    "workspace.library": [
        "${env:VIMRUNTIME}",
        "${3rd}/busted/library",
        "${workspaceFolder}/meta"
    ],
    "workspace.ignoreDir": ["plenary.nvim", ".agents"],
    "diagnostics.globals": [
        "describe",
        "it",
        "before_each",
        "after_each",
        "pending",
        "assert",
        "spy",
        "stub",
        "mock",
        "rex"
    ]
}
